# anyWays — Production Environment Variables
# COPY these to your deployment platform (e.g., Vercel, Netlify)
# DO NOT include sensitive SERVICE_ROLE_KEYS here!

# 1. Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# 2. Observability (Sentry)
# Found in: Sentry -> Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn.sentry.io/project-id

# 3. Environment Context
# Must be 'production', 'staging', or 'local'
VITE_APP_ENV=production

# ============================================================
# BACKEND SECRETS (Set these in Supabase Dashboard -> Edge Functions -> Secrets)
# DO NOT put these in the frontend .env!
# - SERVICE_ROLE_KEY
# - SENTRY_DSN (for Edge Functions)
# - SUPABASE_URL
# ============================================================
